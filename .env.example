# Copy to .env on your server; never commit actual credentials.
# Set both admin values before exposing the service.
BASIC_USER=
BASIC_PASS=
# Optional upload access code. Use your own strong value.
AUTH_CODE=
# Comma-separated trusted public hostnames, without a scheme or path.
PUBLIC_HOSTS=images.example.com
# Native R2 access is optional. Leave all four blank for local storage.
R2_S3_ENDPOINT=
R2_S3_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
